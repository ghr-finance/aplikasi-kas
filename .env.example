# ============================================================
# TEMPLATE ENVIRONMENT VARIABLES (AMAN UNTUK GITHUB)
# Salin file ini menjadi .env untuk penggunaan lokal,
# atau isi nilainya di Vercel -> Project Settings -> Environment Variables
# ============================================================

PORT=3025
NODE_ENV=production

# OPSI 1: Parameter Database Terpisah
DB_HOST=your-cloud-mysql-host.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=aplikasi_kas
# Set true untuk cloud MySQL (Aiven, TiDB Cloud, PlanetScale, Railway)
DB_SSL=true
DB_CONNECTION_LIMIT=5

# OPSI 2: Connection String URL (jika diisi, Opsi 1 diabaikan)
# DATABASE_URL=mysql://user:password@host:port/aplikasi_kas?ssl-mode=REQUIRED

GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GIT_REPO=https://github.com/username/my-project.git
